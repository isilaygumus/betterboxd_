@page
@model betterboxd_web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Giriş Yap";
}
    <link rel="stylesheet" href="~/css/Login.css" asp-append-version="true" />


<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card bg-custom-card shadow-lg border-0">
                <div class="card-body p-4">
                    <h3 class="card-title text-center mb-4 text-custom-label fw-bold">Betterboxd'ye Giriş Yap</h3>
                    
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                        <div class="mb-3">
                            <label asp-for="Input.UsernameOrEmail" class="form-label text-custom-label small">Kullanıcı Adı veya E-Posta</label>
                            <input asp-for="Input.UsernameOrEmail" class="form-control input-custom" placeholder="Kullanıcı adı veya e-posta" />
                            <span asp-validation-for="Input.UsernameOrEmail" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label text-custom-label small">Şifre</label>
                            <input asp-for="Input.Password" class="form-control input-custom" placeholder="******" />
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="Input.RememberMe" class="form-check-input bg-secondary border-0" />
                            <label asp-for="Input.RememberMe" class="form-check-label text-custom-label small">Beni Hatırla</label>
                        </div>

                        <button type="submit" class="btn btn-custom-submit w-100 py-2">GİRİŞ YAP</button>
                    </form>

                    <div class="text-center mt-3">
                        <span class="text-custom-label small">Hesabın yok mu?</span> 
                        <a asp-page="/Account/Signup" class="link-custom small">Üye Ol</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


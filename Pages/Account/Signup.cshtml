@page
@model betterboxd_web.Pages.Account.SignupModel
@{
    ViewData["Title"] = "Giriş Yap";
}
    <link rel="stylesheet" href="~/css/Login.css" asp-append-version="true" />


<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card bg-custom-card shadow-lg border-0">
                <div class="card-body p-4">
                    <h3 class="card-title text-center mb-4 text-custom-label fw-bold">Betterboxd'ye Üye Ol</h3>
                    
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                        <div class="mb-3">
                            <label asp-for="Input.Username" class="form-label text-custom-label small">Kullanıcı Adı</label>
                            <input asp-for="Input.Username" class="form-control input-custom" placeholder="Kullanıcı adı" />
                            <span asp-validation-for="Input.Username" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label text-custom-label small">E-Posta</label>
                            <input asp-for="Input.Email" class="form-control input-custom" placeholder="E-posta" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label text-custom-label small">Şifre</label>
                            <input asp-for="Input.Password" class="form-control input-custom" placeholder="******" />
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-custom-submit w-100 py-2">Üye Ol</button>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>


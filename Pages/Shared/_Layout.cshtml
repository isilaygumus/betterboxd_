<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Betterboxd</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/betterboxd_web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    @await RenderSectionAsync("Styles", required:false)

</head>
<body>
    @{
        // Şu an açık olan sayfa (ör. "/Index"), menüde o linki işaretlemek için
        var aktifSayfa = ViewContext.RouteData.Values["page"]?.ToString();

        // Sayfa ViewData["MenuUstte"] verdiyse menü üstte yatay, vermediyse solda alt alta
        var menuUstte = ViewData["MenuUstte"] != null;
    }

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-custom-navbar border-bottom box-shadow mb-3 @(menuUstte ? "ust-menu" : "")">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-page="/Index">betterboxd</a>

                @* Sayfa isterse üst çubuğa kendi içeriğini koyabilir (ör. ana sayfadaki arama kutusu) *@
                @await RenderSectionAsync("UstArama", required: false)

                @* Sayfa ViewData["MenuUstte"] verirse menü solda değil, burada yatay gösterilir (ör. Log in sayfası) *@
                @if (menuUstte)
                {
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">Films</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">Lists</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Account/Login">Log in</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Profil">Profil</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
                }
            </div>
        </nav>
    </header>

    <div class="container">
        @if (menuUstte)
        {
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        }
        else
        {
        <div class="row">
            <!-- Sol menü: mobilde yan yana, masaüstünde alt alta -->
            <nav class="col-12 col-md-3 col-lg-2 mb-4">
                <ul class="sol-menu nav flex-row flex-md-column">
                    <li class="nav-item"><a class="nav-link @(aktifSayfa == "/Index" ? "aktif" : "")" asp-area="" asp-page="/Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Index">Films</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Index">Lists</a></li>
                    <li class="nav-item"><a class="nav-link @(aktifSayfa == "/Account/Login" ? "aktif" : "")" asp-area="" asp-page="/Account/Login">Log in</a></li>
                    <li class="nav-item"><a class="nav-link @(aktifSayfa == "/Profil" ? "aktif" : "")" asp-area="" asp-page="/Profil">Profil</a></li>
                    <li class="nav-item"><a class="nav-link @(aktifSayfa == "/Privacy" ? "aktif" : "")" asp-area="" asp-page="/Privacy">Privacy</a></li>
                </ul>
            </nav>

            <main role="main" class="col-12 col-md-9 col-lg-10 pb-3">
                @RenderBody()
            </main>
        </div>
        }
    </div>


    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - betterboxd_web - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

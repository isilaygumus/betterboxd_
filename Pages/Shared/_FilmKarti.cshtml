@model betterboxd_web.Models.Movie

@* Tek bir film kartı: afiş, ad, yıl · yönetmen ve puan.
   Kullanımı: <partial name="_FilmKarti" model="film" /> *@
<a asp-page="/Movies/Details" asp-route-id="@Model.Id" class="text-decoration-none text-reset">
<div class="card film-karti h-100">
    @if (Model.PosterUrl != null)
    {
        <img src="@Model.PosterUrl" alt="@Model.Title" title="@Model.Title (@Model.Year)" class="afis" loading="lazy" />
    }
    else
    {
        <div class="afis afis-yok"><span>@Model.Title</span></div>
    }
    <div class="card-body px-0 py-2">
        <h5 class="card-title">@Model.Title</h5>
        <p class="card-text mb-1">@Model.Year · @Model.Director</p>
        <span class="puan">★ @Model.Rating</span>
    </div>
</div>
</a>